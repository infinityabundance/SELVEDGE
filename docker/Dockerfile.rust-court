# SELVEDGE Rust court.
#
# Minimal Debian-based image: pinned Rust stable toolchain plus the packages a
# Cargo workspace needs (linker, pkg-config, CA roots, git for the identity
# court). The court mounts /work, /cargo and /work/target, runs as the host UID,
# and never gets the network unless the caller passes --net.
#
# python3 (stdlib only) is present because the capability court (P12.8/P12.9)
# must drive Rust checkers and score their outcomes inside one sandbox: the
# model runs in the oracle court, which has torch but no cargo, so the check
# stage needs a python interpreter in an image that also has rustc. No third-
# party Python packages are installed here, and the harness uses the standard
# library only for exactly that reason.
#
# Build with scripts/build-courts.sh; the resulting image id and base digest are
# recorded in docker/IMAGES.lock.
ARG RUST_BASE=rust:1.98-slim
FROM ${RUST_BASE}

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        jq \
        pkg-config \
        procps \
        python3 \
        python3-minimal \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

# Stable toolchain components required by the verification courts. They are
# installed into the image so offline `cargo fmt --check` and `cargo clippy`
# runs work without network access.
RUN rustup component add rustfmt clippy

# Keep the upstream toolchain and PATH; CARGO_HOME is overridden at run time to
# the persistent /cargo cache. Record the versions the image was built with.
RUN rustc --version && cargo --version && cc --version | head -1

WORKDIR /work
