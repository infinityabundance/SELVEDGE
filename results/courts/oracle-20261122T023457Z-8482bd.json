    "\nimport sys\nsys.path.insert(0, 'oracle/tests'); sys.path.insert(0, 'oracle'); sys.path.insert(0, 'scripts')\nimport test_s70_preference_weighting as t\npairs = [\n t._pair('p0', 0.25, prompt=(1,2), chosen=(6,7), rejected=(0,1)),\n t._pair('p1', 0.20, prompt=(2,3), chosen=(5,6), rejected=(0,2)),\n t._pair('p2', 0.15, prompt=(3,4), chosen=(4,5), rejected=(1,3)),\n t._pair('p3', 0.10, prompt=(4,5), chosen=(3,4), rejected=(2,4)),\n t._pair('p4', 0.05, prompt=(5,6), chosen=(2,3), rejected=(3,5)),\n]\nsteps=87\nfor label,(o,n) in (('base',('shuffled','batch')),('order',('weighted','batch')),('both',('weighted','corpus'))):\n    traj, s = t._trajectory(o,n,steps=steps,pairs=pairs)\n    print(label, 'end', [round(float(v),6) for v in traj[-1]], 'move', round(float((traj[-1]-traj[0]).norm()),6), 'mean_w', round(s['realized_mean_weight'],6), 'upd', round(s['mean_update_l2'],6))\nbase,_=t._trajectory('shuffled','batch',steps=steps,pairs=pairs)\norder,_=t._trajectory('weighted','batch',steps=steps,pairs=pairs)\nboth,_=t._trajectory('weighted','corpus',steps=steps,pairs=pairs)\nprint('order vs base mean,final', [round(v,6) for v in t._mean_trajectory_distance(base,order)])\nprint('both  vs base mean,final', [round(v,6) for v in t._mean_trajectory_distance(base,both)])\n"
