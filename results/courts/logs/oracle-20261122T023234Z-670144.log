    def test_a_pure_loss_rescale_alone_is_mostly_cancelled_by_adamw():
        """The measured reason the ordering, not the normalizer, is the mechanism.
    
        Same order, same pairs, same AdamW; only the loss scale differs (the corpus
        normaliser on or off). AdamW normalises each parameter's update by its own
        gradient history, so a rescale moves the trajectory far less than changing
        which pair each step sees. This is not exactly zero when the per-step scale
        varies (the Adam moments mix differently-scaled gradients), which is why the
        normaliser is kept as the mathematical statement while the ordering is the
        primary mechanism. The assertion is relative: the rescale-only difference
        must be small compared with the ordering difference.
        """
        unweighted, _ = _trajectory("shuffled", "batch")
        rescaled, _ = _trajectory("shuffled", "corpus")
        weighted, _ = _trajectory("weighted", "corpus")
        rescale_differences = [float((a - b).norm())
                               for a, b in zip(unweighted, rescaled)]
        ordering_differences = [float((a - b).norm())
                                for a, b in zip(unweighted, weighted)]
        rescale = sum(rescale_differences) / len(rescale_differences)
        ordering = sum(ordering_differences) / len(ordering_differences)
        assert ordering > 1e-3
