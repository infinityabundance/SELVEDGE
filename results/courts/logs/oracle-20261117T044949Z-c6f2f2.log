            [nearest], lr=increment, betas=(0.9, 0.95), block=BLOCK,
            weight_rounding="nearest")
        for _ in range(steps):
            for parameter, opt in ((compensated, optimizer), (nearest, control)):
                parameter.grad = torch.ones_like(parameter)
                opt.step()
    
