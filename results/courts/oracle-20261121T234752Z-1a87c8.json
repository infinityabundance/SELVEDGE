    "python3",
    "-c",
    "\nimport sys, json\nsys.path.insert(0,'/work/oracle'); sys.path.insert(0,'/work/scripts')\nfrom frontier import rft\nfrom s55_stage2_data import load_tokenizer, render_prompt, _questions\ntok=load_tokenizer('/hf-cache/models/Qwen/Qwen3.5-0.8B/2fc06364715b967f1860aea9cf38778875588b17')\nrows=[]\nwith open('/work/results/artifacts/stage2/s58-combined/stage2a-accepted-combined.jsonl') as f:\n    for line in f:\n        r=json.loads(line)\n        rows.append(r)\n        if len(rows)>=4000: break\nby_id={}\nfor r in rows: by_id.setdefault(r['id'],r)\n# take 30 ids across both datasets, rebuild the question from rft\nitems=rft.load_items('gsm8k-train',limit=None)\nitems2=rft.load_items('math-train',limit=None)\nqmap={it['id']:it for it in items+items2}\nchecked=0; match=0; mism=0; missing=0\nfor pid,r in list(by_id.items()):\n    if pid not in qmap: missing+=1; continue\n    ds=qmap[pid]['dataset']\n    name='gsm8k-train' if ds=='gsm8k' else 'math-train'\n    q=_questions(name,[qmap[pid]])[0]\n    text=render_prompt(tok,q)\n    ids=tok(text,add_special_tokens=False)['input_ids']\n    checked+=1\n    if ids==r['prompt_ids']: match+=1\n    else:\n        mism+=1\n        if mism<=3: print('MISMATCH',pid,len(ids),len(r['prompt_ids']),repr(text[:80]))\n    if checked>=200: break\nprint('checked',checked,'match',match,'mismatch',mism,'missing',missing)\n"
