  "argv": [
    "bash",
    "-c",
    "\nset -Eeuo pipefail\nwork=$(mktemp -d /tmp/selvedge-smoke.XXXXXX)\ncd \"$work\"\ncargo init --lib --name selvedge_smoke --vcs none --quiet\ncat > src/lib.rs <<\"RS\"\n//! Temporary smoke crate: proves the Rust court can compile and run tests\n//! offline in the bounded /tmp tmpfs. Never committed.\n\npub fn silu_gated(x: f32, gate: f32) -> f32 {\n    let silu = x / (1.0 + (-x).exp());\n    silu * gate\n}\n\n#[cfg(test)]\nmod tests {\n    use super::silu_gated;\n\n    #[test]\n    fn silu_gated_matches_definition() {\n        let x = 1.0_f32;\n        let gate = 2.0_f32;\n        let expected = (x / (1.0 + (-x).exp())) * gate;\n        assert!((silu_gated(x, gate) - expected).abs() < 1e-6);\n    }\n\n    #[test]\n    fn silu_gated_is_zero_at_zero() {\n        assert_eq!(silu_gated(0.0, 5.0), 0.0);\n    }\n}\nRS\ncargo test 2>&1 | tail -12\n"
  ],
