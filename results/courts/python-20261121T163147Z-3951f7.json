    "\nimport sys, json\nsys.path.insert(0,'scripts')\nimport s57_paired as p\ndef row(path, task):\n    d=json.load(open(path))\n    for r in d['tasks']:\n        if r['task']==task and r.get('mode')=='non-thinking' and r.get('decoding')=='greedy': return r\ndef show(c,b,label):\n    out=p.compare_task(row(c['p'],c['t']), row(b['p'],b['t']))\n    f=out['bases']['flexible']\n    print(label, f\"{100*f['candidate_accuracy']:.2f} vs {100*f['baseline_accuracy']:.2f} delta={100*f['delta']:+.2f} ci=[{100*f['ci95'][0]:+.2f},{100*f['ci95'][1]:+.2f}] above0={f['interval_above_zero']}\")\ntest={'p':'results/stage2/s68-ramp/test-stage1.json'}\npost={'p':'results/stage1/s54-stage1-post-0.8b-nonthinking-greedy.json'}\nbasefull={'p':'results/stage2/s67-final/baseline-math-full.json'}\nchamp={'p':'results/stage2/s67-final/soup-stage1.json'}\nfor t in ['gsm8k','math500','math_full']:\n    if t=='math_full':\n        b=basefull\n    else:\n        b=post\n    show({'p':test['p'],'t':t},{'p':b['p'],'t':t},'ramp-vs-post '+t)\n    show({'p':test['p'],'t':t},{'p':champ['p'],'t':t},'ramp-vs-champ '+t)\n"
