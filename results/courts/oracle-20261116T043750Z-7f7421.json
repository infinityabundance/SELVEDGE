{
  "argv": [
    "python3",
    "-c",
    "\nimport sys, torch, transformers\nsys.path.insert(0, 'oracle/eval')\nimport harness\ncfg = transformers.Qwen3Config(vocab_size=97, hidden_size=32, intermediate_size=37,\n    num_hidden_layers=2, num_attention_heads=2, num_key_value_heads=1, head_dim=16,\n    max_position_embeddings=256, tie_word_embeddings=False)\ntorch.manual_seed(0); m = transformers.Qwen3ForCausalLM(cfg); m.eval()\nids = torch.tensor([[3,11,5,90,7,42,1,63]])\nwith torch.inference_mode():\n    full = m(input_ids=ids, use_cache=False).logits.float()\n    hidden = harness.final_hidden_states(m, ids)\n    print('hidden equal:', torch.equal(hidden, m.model(input_ids=ids, use_cache=False).last_hidden_state))\n    for a,b in ((0,3),(3,6),(6,7)):\n        chunk = harness.logits_chunk(m, hidden, a, b)\n        print(a,b,'max abs logit diff', float((chunk-full[:,a:b]).abs().max()), 'equal', torch.equal(chunk, full[:,a:b]))\n    chunk = m.lm_head(hidden[:,0:3].contiguous()); print('contig max diff', float((chunk - full[:,0:3]).abs().max()))\n    lp_full = torch.log_softmax(full, dim=-1); lp_chunk = torch.log_softmax(m.lm_head(hidden[:,0:3]), dim=-1)\n    print('logsoftmax max diff', float((lp_full[:,0:3]-lp_chunk).abs().max()))\n"
  ],
