#!/usr/bin/env bash
# Short aliases over scripts/docker-court.sh. Everything still runs in the
# court with the same hard limits; this script only chooses the argv.
#
# Usage:
#   scripts/court [--net] [--gpu] rust test [cargo args...]
#   scripts/court rust fmt | clippy | build | check | run | bench | doc
#   scripts/court rust -- cargo test -p selvedge-core
#   scripts/court python scripts/perf_numbers.py --check
#   scripts/court python -m pytest tests
#   scripts/court --net oracle -- python3 scripts/oracle/fetch_models.py
#   scripts/court --gpu oracle -- python3 oracle/probe_oracle.py --json
#   scripts/court --gpu eval -- python3 scripts/s34_anchor.py run --config ...
#   scripts/court --gpu vllm -- python3 scripts/s56_vllm_smoke.py ...
#   scripts/court io -- fio --name=seq --filename=/work/target/io.bin ...
#   scripts/court commit_identity
#   scripts/court perf_numbers
#   scripts/court status_consistency
#   scripts/court prereg_provenance
#   scripts/court --gpu --detach oracle -- python3 oracle/train/loop.py ...
#   scripts/court wait results/courts/pending/<container>.json
set -Eeuo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
court_runner="$script_dir/docker-court.sh"

usage() {
  sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

if (($# == 0)); then
  usage >&2
  exit 64
fi

declare -a flags=()
while (($#)); do
  case "$1" in
    --net | --gpu | --host-root-ro | --detach)
      flags+=("$1")
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

if (($# == 0)); then
  usage >&2
  exit 64
fi

court="$1"
shift

case "$court" in
  rust)
    if (($# == 0)); then
      exec "$court_runner" rust "${flags[@]}"
    fi
    if [[ "$1" == "--" ]]; then
      shift
      exec "$court_runner" rust "${flags[@]}" -- "$@"
    fi
    case "$1" in
      fmt | clippy | build | check | test | run | bench | doc | update | metadata | tree)
        subcommand="$1"
        shift
        exec "$court_runner" rust "${flags[@]}" -- cargo "$subcommand" "$@"
        ;;
      *)
        exec "$court_runner" rust "${flags[@]}" -- "$@"
        ;;
    esac
    ;;
  python)
    if (($# == 0)); then
      exec "$court_runner" python "${flags[@]}"
    fi
    if [[ "$1" == "--" ]]; then
      shift
      exec "$court_runner" python "${flags[@]}" -- "$@"
    fi
    exec "$court_runner" python "${flags[@]}" -- python3 "$@"
    ;;
  oracle)
    if (($# == 0)); then
      exec "$court_runner" oracle "${flags[@]}"
    fi
    if [[ "$1" == "--" ]]; then
      shift
      exec "$court_runner" oracle "${flags[@]}" -- "$@"
    fi
    exec "$court_runner" oracle "${flags[@]}" -- python3 "$@"
    ;;
  io)
    if (($# == 0)); then
      exec "$court_runner" io "${flags[@]}"
    fi
    if [[ "$1" == "--" ]]; then
      shift
      exec "$court_runner" io "${flags[@]}" -- "$@"
    fi
    exec "$court_runner" io "${flags[@]}" -- "$@"
    ;;
  eval)
    if (($# == 0)); then
      exec "$court_runner" eval "${flags[@]}"
    fi
    if [[ "$1" == "--" ]]; then
      shift
      exec "$court_runner" eval "${flags[@]}" -- "$@"
    fi
    exec "$court_runner" eval "${flags[@]}" -- python3 "$@"
    ;;
  vllm)
    if (($# == 0)); then
      exec "$court_runner" vllm "${flags[@]}"
    fi
    if [[ "$1" == "--" ]]; then
      shift
      exec "$court_runner" vllm "${flags[@]}" -- "$@"
    fi
    exec "$court_runner" vllm "${flags[@]}" -- python3 "$@"
    ;;
  commit_identity)
    exec "$court_runner" commit_identity "${flags[@]}" -- "$@"
    ;;
  wait)
    exec "$court_runner" wait -- "$@"
    ;;
  perf_numbers)
    if (($# == 0)); then
      exec "$court_runner" perf_numbers "${flags[@]}"
    fi
    exec "$court_runner" perf_numbers "${flags[@]}" -- python3 scripts/perf_numbers.py "$@"
    ;;
  status_consistency)
    if (($# == 0)); then
      exec "$court_runner" status_consistency "${flags[@]}"
    fi
    exec "$court_runner" status_consistency "${flags[@]}" -- python3 scripts/status_consistency.py "$@"
    ;;
  prereg_provenance)
    if (($# == 0)); then
      exec "$court_runner" prereg_provenance "${flags[@]}"
    fi
    exec "$court_runner" prereg_provenance "${flags[@]}" -- python3 scripts/prereg_provenance.py "$@"
    ;;
  *)
    printf 'court: unknown court %q\n' "$court" >&2
    usage >&2
    exit 64
    ;;
esac
